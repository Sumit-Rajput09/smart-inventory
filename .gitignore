@'
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml

# Environment variables
.env
.env.*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.log
*.tmp

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Generated reports
reports/generated/
'@ | Set-Content -Encoding utf8 .gitignore